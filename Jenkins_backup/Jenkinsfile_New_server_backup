pipeline {
    agent { label 'master' }

    triggers {
        cron('H 2 * * *')
    }

    stages {

        stage('Backup Jenkins Home') {
            steps {
                sh '''
                DATE=$(date +%F)
                mkdir -p /tmp/jenkins_backup
                tar -czf /tmp/jenkins_backup/jenkins_backup_$DATE.tar.gz /var/lib/jenkins
                '''
            }
        }

        stage('Transfer Backup to New Server') {
            steps {
                sh '''
                DATE=$(date +%F)
                scp /tmp/jenkins_backup/jenkins_backup_$DATE.tar.gz ubuntu@13.233.138.210:/tmp/jenkins_backup/
                '''
            }
        }

    }
}