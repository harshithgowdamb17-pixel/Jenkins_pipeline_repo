pipeline {
    agent any

    triggers {
        cron('H 2 * * *')
    }

    environment {
        BACKUP_DIR = "/var/lib/jenkins/Jenkins"
    }

    stages {

        stage('Prepare Backup Directory') {
            steps {
                sh '''
                mkdir -p $BACKUP_DIR
                '''
            }
        }

        stage('Create Timestamp') {
            steps {
                sh '''
                date > $BACKUP_DIR/Timestamp
                '''
            }
        }

        stage('Backup Jenkins Home') {
            steps {
                sh '''
                DATE=$(date +%F)
                sudo tar -czf $BACKUP_DIR/jenkins_backup_$DATE.tar.gz /var/lib/jenkins
                '''
            }
        }

        stage('Cleanup Old Backups') {
            steps {
                sh '''
                cd $BACKUP_DIR
                ls -t jenkins_backup_*.tar.gz | tail -n +8 | xargs -r rm --
                '''
            }
        }

    }
}