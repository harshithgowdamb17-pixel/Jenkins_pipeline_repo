pipeline {
    agent { label 'master' }

    triggers {
        cron('H 2 * * *')
    }

    stages {

        stage('Prepare Backup Directory') {
            steps {
                sh '''
                mkdir -p backup
                '''
            }
        }

        stage('Create Timestamp') {
            steps {
                sh '''
                date > backup/Timestamp
                '''
            }
        }

        stage('Backup Jenkins Home') {
            steps {
                sh '''
                DATE=$(date +%F)
                sudo /usr/bin/tar -czf backup/jenkins_backup_$DATE.tar.gz /var/lib/jenkins
                '''
            }
        }

    }
}